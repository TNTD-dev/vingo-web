# Base path của API. Dev: Vite proxy /api → API_PROXY_TARGET. Production: Caddy cùng domain.
VITE_API_BASE=/api/v1
# Backend cho Vite proxy khi chạy dev (không nhúng vào bundle).
API_PROXY_TARGET=http://localhost:8080
# true = chạy hoàn toàn bằng mock MSW sinh từ contract (không cần backend).
VITE_USE_MOCK=false
# Vai trò user giả khi dùng mock: ADMIN (mặc định) hoặc BUYER.
VITE_MOCK_ROLE=ADMIN
# Để trống thì không bật Sentry.
VITE_SENTRY_DSN=
